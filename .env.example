# ─────────────────────────────────────────────────────────────────────────────
# RAG Tax — variables de entorno
# Copiá este archivo a .env (local) o cargá las variables en Render → Environment.
# NUNCA commitees el .env real ni expongas estos valores al browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── App / auth ───────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
AUTH_SECRET=                 # 32+ chars aleatorios. Firma sesiones y el "state" OAuth (CSRF).
ANTHROPIC_API_KEY=          # Clave de Claude para las funciones de IA.

# Claude review tuning. Larger values preserve more source text but can make
# complex reviews time out. The server retries timed-out reviews with the
# smaller retry limits below.
ANTHROPIC_REQUEST_TIMEOUT_MS=300000
CLAUDE_REVIEW_MAX_TOKENS=16000
CLAUDE_REVIEW_MAX_TOTAL_CHARS=140000
CLAUDE_REVIEW_MAX_CHARS_PER_FILE=55000
CLAUDE_REVIEW_MIN_CHARS_PER_FILE=6000
CLAUDE_REVIEW_RETRY_MAX_TOTAL_CHARS=80000
CLAUDE_REVIEW_RETRY_MAX_CHARS_PER_FILE=30000
CLAUDE_REVIEW_RETRY_MIN_CHARS_PER_FILE=3000

# Clave para encriptar tokens OAuth en reposo (AES-256-GCM). 64 hex chars.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Base de datos server-side (Supabase Postgres). No exponer al browser.
# La app usa esta URL solo desde el servidor para migrar y luego persistir datos sensibles.
DATABASE_URL=
DATABASE_POOL_MAX=5
DEFAULT_TENANT_ID=rag-tax-ai
DEFAULT_TENANT_NAME=RAG Tax AI

# Security controls. Normal-user limits are intentionally generous; they are
# meant to stop runaway scripts/abuse, not normal work sessions.
USER_AI_RATE_LIMIT_WINDOW_MS=3600000
USER_AI_RATE_LIMIT_MAX=80
USER_UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
USER_UPLOAD_RATE_LIMIT_MAX=160
ADMIN_WRITE_RATE_LIMIT_WINDOW_MS=600000
ADMIN_WRITE_RATE_LIMIT_MAX=40
ADMIN_READ_RATE_LIMIT_WINDOW_MS=60000
ADMIN_READ_RATE_LIMIT_MAX=120
CLIENT_FILE_RETENTION_DAYS=365

# Optional admin two-factor authentication by email. Leave disabled until SMTP
# is confirmed and ADMIN_2FA_EMAIL is an inbox you control.
ADMIN_2FA_ENABLED=false
ADMIN_2FA_EMAIL=
ADMIN_2FA_CODE_TTL_MS=600000
ADMIN_2FA_MAX_ATTEMPTS=5

# Public login page access requests. Leads are always saved in data/access_requests.json.
# Configure SMTP if you want each request to email the sales/contact inbox.
ACCESS_REQUEST_NOTIFY_EMAIL=ramiroflores@ragtax-ia.com
ACCESS_REQUEST_FROM_EMAIL=no-reply@ragtax-ia.com
ACCESS_REQUEST_SMTP_HOST=
ACCESS_REQUEST_SMTP_PORT=587
ACCESS_REQUEST_SMTP_SECURE=false
ACCESS_REQUEST_SMTP_STARTTLS=true
ACCESS_REQUEST_SMTP_USER=
ACCESS_REQUEST_SMTP_PASS=

# ── QuickBooks Online (Intuit) ───────────────────────────────────────────────
# developer.intuit.com → tu app → Keys & credentials
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox      # "sandbox" para pruebas, "production" para clientes reales
# Redirect URI EXACTA registrada en Intuit (debe coincidir carácter por carácter):
QBO_REDIRECT_URI=https://rag-prueba-web.onrender.com/auth/accounting/quickbooks/callback
# Para desarrollo local registrá también: http://localhost:8080/auth/accounting/quickbooks/callback

# ── Xero ─────────────────────────────────────────────────────────────────────
# developer.xero.com → My Apps → tu app → Configuration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Redirect URI EXACTA registrada en Xero:
XERO_REDIRECT_URI=https://rag-prueba-web.onrender.com/auth/accounting/xero/callback
# Para desarrollo local registrá también: http://localhost:8080/auth/accounting/xero/callback

# ── CCH Axcess (opcional — ver tax-loader/CCH_PENDING.md) ─────────────────────
# CCH_BASE_URL=
# CCH_CLIENT_ID=
# CCH_CLIENT_SECRET=
